{
  "name": "Datum — PDF Markup & Measurement",
  "short_name": "Datum",
  "description": "PDF markup & measurement for construction quantity-surveying and project-management teams.",
  "start_url": "./BDM-PDF-Markup-Tool.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0E1830",
  "theme_color": "#0E1830",
  "orientation": "any",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./BDM-PDF-Markup-Tool.html",
      "accept": {
        "application/pdf": [".pdf"]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
